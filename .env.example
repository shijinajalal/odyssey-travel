# Set to the production origin before deployment; the example domain is not a real site.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Enquiry delivery via Resend. Leave unset until the business inbox is verified.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Optional verified WhatsApp number in international format, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=
